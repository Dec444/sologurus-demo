# ── TrueFoundry AI Gateway ───────────────────────────────────────────────────
# Every model call in Sologurus is routed, guardrailed and metered here.
# Create a Virtual Account Token under Access in the TrueFoundry platform.
# Without these, the app still runs: it falls back to the deterministic planner
# and labels every AI panel as offline.
TFY_API_KEY=
# Your control plane's gateway URL. SaaS is https://gateway.truefoundry.ai;
# a dedicated control plane serves the gateway under /api/llm, for example
# https://solo.truefoundry.cloud/api/llm — confirm in the Playground's Code
# Snippet tab, which prints the exact base URL for your deployment.
TFY_GATEWAY_BASE_URL=https://solo.truefoundry.cloud/api/llm
# OpenAI-compatible route on that gateway. Check the Playground's Code Snippet
# tab; some self-hosted deployments front it at /v1/chat/completions instead.
TFY_INFERENCE_PATH=/api/inference/openai/chat/completions
# Ordered fallback chain, `provider-account/model-name`, first entry preferred.
TFY_MODEL_CHAIN=google-gemini/gemma-4-26b-a4b-it
# Guardrail groups configured in the gateway, applied to every request.
TFY_INPUT_GUARDRAILS=sologurus/pii-redaction
TFY_OUTPUT_GUARDRAILS=sologurus/content-safety
# Cost-attribution tags sent as x-tfy-metadata; also the keys a gateway
# rate-limit or budget rule can match on in its `when` block.
TFY_TENANT=sologurus-demo
TFY_COST_CENTER=learner-success
TFY_ENVIRONMENT=hackathon
# Reliability ceilings for exam-season traffic peaks.
TFY_REQUEST_TIMEOUT_MS=45000
TFY_TTFT_TIMEOUT_MS=
# Optional overrides for the learner-visible spend estimate, USD per million
# tokens. The gateway's own cost metrics remain authoritative.
TFY_PRICE_INPUT_PER_MTOK=
TFY_PRICE_OUTPUT_PER_MTOK=

# ── TrueFoundry MCP Gateway ──────────────────────────────────────────────────
# Notion is the registered MCP server for this workspace. Calendar is not
# brokered and does not need to be: the .ics export is generated in the browser
# and imports into Google, Apple, or Outlook with no integration at all.
#
# Registered servers as `label:integrationId` pairs. The label is what the
# product calls the server; the integration id is the one shown on the server's
# row in the MCP Servers list. The gateway proxies it at
# {MCP_BASE_URL}/mcp/{integrationId}/server over streamable HTTP and holds the
# Notion credential — Sologurus does not.
TFY_MCP_SERVERS=https://gateway.truefoundry.ai/solo/mcp/notion/server
# The MCP proxy may sit on a different prefix from the inference endpoint.
# Leave blank to reuse TFY_GATEWAY_BASE_URL; set it if the console shows a
# different host or prefix for the MCP server URL.
TFY_MCP_BASE_URL=https://solo.truefoundry.cloud/llm-gateway/mcp-servers
# Skills allowlist: `server/tool`, or `server/*` for a whole server. This is the
# application-side mirror of the Agent Skills Registry and is CLOSED BY DEFAULT
# — a tool that is not named here cannot be called, even if the server exposes it.
# These are the official Notion MCP tool names Sologurus actually uses.
TFY_MCP_ALLOWED_TOOLS=notion/notion-create-pages,notion/notion-search
# Optional Notion page id the plan pages are created under. Without it, pages
# land wherever the integration's default parent is.
TFY_MCP_NOTION_PARENT=
TFY_MCP_TIMEOUT_MS=20000

# ── Console deep links ───────────────────────────────────────────────────────
# Sologurus links operators straight into their own control plane to add models
# and register MCP servers. Derived from TFY_GATEWAY_BASE_URL's origin unless
# set here; nothing is derived from the shared SaaS gateway host, because that
# is not a console.
TFY_CONSOLE_URL=https://solo.truefoundry.cloud
TFY_CONSOLE_MODELS_PATH=/llm-gateway
TFY_CONSOLE_MCP_PATH=/llm-gateway/mcp-servers

# ── Notion ───────────────────────────────────────────────────────────────────
# There is deliberately no NOTION_TOKEN. Notion is reached only through the MCP
# Gateway above: the platform holds the credential, the registry decides which
# tools exist, and Sologurus can neither read nor write Notion unless an
# administrator registers the server and grants the tools.

# ── Calendar ─────────────────────────────────────────────────────────────────
# Optional verified Google Calendar series link for the connected demo.
GOOGLE_CALENDAR_EVENT_URL=
